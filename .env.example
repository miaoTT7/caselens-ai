# Docker Compose PostgreSQL settings
POSTGRES_DB=caselens
POSTGRES_USER=caselens
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_PORT=5432

# FastAPI runs on the host, so it connects through the published port.
DATABASE_URL=postgresql+asyncpg://caselens:replace_with_a_strong_local_password@localhost:5432/caselens

# BGE reranker defaults (quality profile). For the optional fast profile,
# change only RERANK_CANDIDATES to 20.
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATES=32
RERANK_BATCH_SIZE=8
RERANK_MAX_LENGTH=256

# Grounded answer generation
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
